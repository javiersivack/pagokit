# Access token de tu aplicación (Tus integraciones → Credenciales).
# Usá el de prueba (TEST-...) en desarrollo.
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Clave secreta de webhooks (Tus integraciones → Webhooks → Configurar notificaciones).
MP_WEBHOOK_SECRET=

# URL pública de la app (para back_urls). En local: http://localhost:3000
APP_URL=http://localhost:3000

# Opcional: "true" para rechazar pagos de prueba (live_mode=false) en producción.
MP_REQUIRE_LIVE_MODE=false
